# Supabase Edge Functions secrets. Do not commit a real copy of this file.

# Required by AI chat, translation, diary, word detail, shadowing, and text fallback.
DEEPSEEK_API_KEY=your-deepseek-api-key

# Used by image understanding and local Qwen TTS. Without it, image input falls
# back to text and speech falls back to the device's system voice.
DASHSCOPE_API_KEY=your-dashscope-api-key

# Miaoda gateway credential used by MiniMax TTS and Baidu speech recognition.
# This is platform-specific; a direct MiniMax or Baidu key is not interchangeable.
INTEGRATIONS_API_KEY=your-miaoda-integrations-api-key

# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically in
# deployed Supabase Edge Functions. Do not expose the service role key to Expo.
