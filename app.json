{
  "expo": {
    "name": "Visual English Coach",
    "slug": "visual-english-coach",
    "version": "1.0.72",
    "orientation": "portrait",
    "icon": "https://miaoda-edit-image.cdn.bcebos.com/cf15398uqfpd/IMG-cg605mch9ts0.png?x-bce-process=image/resize,m_fill,w_1024,h_1024",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "1",
      "bundleIdentifier": "com.miaoda.appcf15398uqfpd"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "package": "com.miaoda.appcf15398uqfpd"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-sqlite",
      "expo-font",
      "expo-system-ui",
      "expo-image",
      "expo-audio",
      "expo-secure-store",
      "expo-file-system",
      [
        "expo-image-picker",
        {
          "cameraPermission": "允许 Visual English Coach 访问相机以拍摄照片",
          "photosPermission": "允许 Visual English Coach 访问相册以选择照片"
        }
      ]
    ],
    "router": {
      "root": "src"
    },
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "appcf15398uqfpd"
  }
}