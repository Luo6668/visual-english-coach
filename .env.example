# Expo 客户端配置。Anon Key 会打包进 App，切勿在这里放 service_role key。
EXPO_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 本地 MySQL 数据 API。Web 本机运行可保留默认值。
EXPO_PUBLIC_DATA_API_URL=http://127.0.0.1:8787/data
EXPO_PUBLIC_LOCAL_AI_URL=http://127.0.0.1:8787/functions/v1

# 本地免费语音模型。首次使用前运行 pnpm speech:setup。
LOCAL_SPEECH_PROVIDER=local
LOCAL_TTS_PORT=8766
KOKORO_EN_VOICE=af_heart
KOKORO_ZH_VOICE=zf_xiaoxiao
KOKORO_DEVICE=cpu

# 仅供本地服务端使用，切勿添加 EXPO_PUBLIC_ 前缀。
DEEPSEEK_API_KEY=your-deepseek-key
DASHSCOPE_API_KEY=your-dashscope-key
DASHSCOPE_VISION_MODEL=qwen3.8-flash
# Optional for non-Beijing API keys, without the trailing /chat/completions path.
# DASHSCOPE_COMPATIBLE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
